# MongoDB Connection URI
# Local MongoDB: mongodb://127.0.0.1:27017/squidgame
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/squidgame

# MongoDB Database Name
MONGODB_DB=squidgame

# Google Gemini API (Server-only evaluation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
